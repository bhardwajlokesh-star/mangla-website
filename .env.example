# ════════════════════════════════════════════════════════════════
# Mangla Healthcare Website - Environment Variables
# ════════════════════════════════════════════════════════════════

# 📊 GOOGLE SHEETS INTEGRATION
# Get this URL from Google Apps Script deployment
# See APPS_SCRIPT_SETUP.md for full setup instructions
VITE_HEALTH_TEST_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# 📱 CONTACT INFORMATION
# These are used throughout the site for CTA buttons and footer
VITE_PHONE_NUMBER=+91 98765 43210
VITE_PHONE_HREF=tel:+919876543210
VITE_WHATSAPP_NUMBER=+919876543210

# 🗺️ MAPS & LOCATION
# Google Maps embed ID for contact page
VITE_GOOGLE_MAPS_EMBED=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3671.9759529321356!2d75.8677!3d22.72

# 📧 EMAIL CONFIGURATION (optional - for backend integration)
VITE_CONTACT_EMAIL=info@manglahealthcare.com
VITE_SUPPORT_EMAIL=support@manglahealthcare.com

# 🎨 BRANDING
VITE_SITE_NAME=Mangla Healthcare
VITE_SITE_TITLE=Evidence-Based Ayurvedic Care | Mangla Healthcare
VITE_SITE_DESCRIPTION=Expert Ayurvedic doctors treating 50+ chronic conditions with personalized protocols

# 🔗 SOCIAL MEDIA
VITE_FACEBOOK_URL=https://facebook.com/manglahealthcare
VITE_INSTAGRAM_URL=https://instagram.com/manglahealthcare
VITE_YOUTUBE_URL=https://youtube.com/manglahealthcare
VITE_WHATSAPP_URL=https://wa.me/919876543210

# 🚀 API ENDPOINTS (if adding backend services)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# ════════════════════════════════════════════════════════════════
# HOW TO USE:
# ════════════════════════════════════════════════════════════════
# 1. Copy this file to .env.local
# 2. Replace YOUR_DEPLOYMENT_ID with your actual Google Apps Script ID
# 3. Update phone numbers and emails with your clinic details
# 4. For production, add these variables to your hosting provider's env settings:
#    - Vercel: Project Settings → Environment Variables
#    - Netlify: Site settings → Build & deploy → Environment
# ════════════════════════════════════════════════════════════════
