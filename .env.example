# ════════════════════════════════════════════════════════════════
# Mangla Healthcare Website - Environment Variables
# Copy to .env.local for local work; set the same values in your
# host's environment settings (Vercel / Netlify) for production.
# Everything starting with VITE_ ends up in the public JavaScript,
# so never put real secrets here.
# ════════════════════════════════════════════════════════════════

# 📊 WEBSITE FORMS → GOOGLE SHEET (see APPS_SCRIPT_SETUP.md)
# Used by every form: Health Test, appointment/contact requests, newsletter.
VITE_HEALTH_TEST_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Optional; must equal SHARED_TOKEN in google-apps-script/Code.gs
VITE_HEALTH_TEST_TOKEN=

# 🔐 DOCTOR PORTAL LOGIN (see src/portal/auth.js)
# Default login is doctor / admin123 — change it before going live.
# Hash your password with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
VITE_PORTAL_USERNAME=doctor
VITE_PORTAL_PASSWORD_SHA256=

# 📈 GOOGLE ANALYTICS 4 (optional — leave empty to disable)
VITE_GA_ID=

# Clinic phone, address, email etc. are edited in src/config/clinic.js
